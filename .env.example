# Long random string. Signs sessions and encrypts stored tokens and camera passwords.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The URL people open Hearth at. Add any other addresses (LAN IP, hostname) to TRUSTED_ORIGINS.
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=

# Optional: a Postgres connection string (Neon, Supabase, or your own server). Leave it empty and Hearth keeps
# its data in an embedded Postgres (PGlite) in DATABASE_PATH instead.
# Neon:     postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/hearth?sslmode=require
# Supabase: postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
# With Docker Compose, a Postgres server runs beside Hearth and this can stay empty; set POSTGRES_PASSWORD instead.
DATABASE_URL=
POSTGRES_PASSWORD=
DATABASE_PATH=data/pglite

# go2rtc relay that turns RTSP into WebRTC for the browser. Each user can override it in Connections.
STREAM_RELAY_URL=http://localhost:1984

# Set to true once your household has its accounts, to close public sign up.
DISABLE_SIGNUP=false
