# Long random string. Signs sessions and encrypts stored tokens and camera passwords.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The URL people open Hearth at. Add any other addresses (LAN IP, hostname) to TRUSTED_ORIGINS.
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=

# SQLite database file.
DATABASE_PATH=data/hearth.db

# go2rtc relay that turns RTSP into WebRTC for the browser. Each user can override it in Connections.
STREAM_RELAY_URL=http://localhost:1984

# Set to true once your household has its accounts, to close public sign up.
DISABLE_SIGNUP=false
